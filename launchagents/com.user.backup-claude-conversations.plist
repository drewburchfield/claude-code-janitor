<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.backup-claude-conversations</string>
    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_DIR__/backup-claude-conversations.sh</string>
    </array>
    <!-- Check every 2 hours (script skips if <12h since last backup) -->
    <key>StartInterval</key>
    <integer>7200</integer>
    <!-- Also run on login -->
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/backup-claude-conversations.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/backup-claude-conversations.log</string>
</dict>
</plist>
